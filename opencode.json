{
  "$schema": "https://json-schema.org",
  "permission": {
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "*": "allow"
    }
  },
  "plugin": [
    "opencode-ignore"
  ],
  "watcher": {
    "ignore": [
      "**/.env",
      "**/.env.*"
    ]
  }
}
    
